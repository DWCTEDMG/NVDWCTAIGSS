# Copy to deployment/nvidia/.env.local or load these values in your shell.
# Do not commit real keys, tokens, model weights, or accepted license artifacts.

EDMG_NVIDIA_MODE=1
EDMG_NVIDIA_PROFILE=omniverse

# NVIDIA/NGC access. Keep the real value outside git.
# Used by NVIDIA containers or setup tools that need to pull gated NGC assets.
NGC_API_KEY=

# Existing EDMG backend will use this as an OpenAI-compatible planning endpoint.
EDMG_AI_PROVIDER=openai_compat
# Keep NIM on host port 8001 so local dev can keep the EDMG backend on 8000.
EDMG_NVIDIA_NIM_URL=http://host.docker.internal:8001
EDMG_AI_OPENAI_COMPAT_BASE_URL=http://host.docker.internal:8001/v1
EDMG_AI_OPENAI_COMPAT_MODEL=meta/llama-3.2-1b-instruct
EDMG_NVIDIA_RIVA_URL=host.docker.internal:50051
EDMG_NVIDIA_RIVA_ASR=0
EDMG_NVIDIA_RIVA_LANGUAGE_CODE=en-US
EDMG_NVIDIA_RIVA_MODEL=
EDMG_NVIDIA_RIVA_ASR_FALLBACK=1
EDMG_RIVA_MODEL_REPOSITORY=D:\Nvidia\NVDWCTAIGSS\riva-models
EDMG_RIVA_S3_BUCKET=
EDMG_RIVA_S3_PREFIX=nvdwctaigss/riva-models
EDMG_RIVA_S3_STORAGE_CLASS=STANDARD
EDMG_S3_ENDPOINT_URL=
EDMG_NVIDIA_OMNIVERSE_URL=
EDMG_NVIDIA_NEMO_URL=
EDMG_NVIDIA_TRITON_URL=
EDMG_NVIDIA_TRITON_MODEL=edmg_shot_features
EDMG_NVIDIA_TRITON_SHOT_MODEL=edmg_shot_features
EDMG_NVIDIA_AUDIO2FACE_URL=
EDMG_NVIDIA_AUDIO2FACE_GENERATE_PATH=
EDMG_NVIDIA_ACE_URL=
EDMG_NVIDIA_ACE_GENERATE_PATH=
EDMG_NVIDIA_COSMOS_URL=
EDMG_NVIDIA_COSMOS_MODEL=
EDMG_NVIDIA_COSMOS_INFER_PATH=/v1/infer
# Only set this when the inference endpoint itself expects bearer auth.
# For some hosted NVIDIA endpoints this may be a separate API key; for local
# NIM containers it can often stay blank.
EDMG_AI_OPENAI_COMPAT_API_KEY=

# Optional local NVIDIA services. Replace these with official images that match
# the chosen NVIDIA service, model family, and license/access channel.
EDMG_NIM_LLM_IMAGE=nvcr.io/nim/meta/llama-3.2-1b-instruct:latest
EDMG_NIM_MAX_MODEL_LEN=8192
EDMG_RIVA_IMAGE=nvcr.io/nvidia/riva/riva-speech:2.19.0
EDMG_NEMO_IMAGE=nvcr.io/nvidia/nemo:26.04.01
EDMG_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.04-py3
EDMG_TRITON_MODEL_REPOSITORY=./deployment/nvidia/triton-model-repository
EDMG_AUDIO2FACE_IMAGE=nvcr.io/nim/nvidia/audio2face-3d:2.0
EDMG_COSMOS_IMAGE=nvcr.io/nim/nvidia/cosmos-reason2-2b:latest
EDMG_NVIDIA_GPU_COUNT=1
EDMG_NIM_LLM_PORT=8001
EDMG_RIVA_GRPC_PORT=50051
EDMG_RIVA_HTTP_PORT=9000
EDMG_TRITON_HTTP_PORT=8002
EDMG_TRITON_GRPC_PORT=8003
EDMG_TRITON_METRICS_PORT=8004
EDMG_AUDIO2FACE_HTTP_PORT=8011
EDMG_COSMOS_HTTP_PORT=8012
