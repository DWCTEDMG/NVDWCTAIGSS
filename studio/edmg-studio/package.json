{
  "name": "edmg-nvidia-workshop",
  "version": "1.1.0",
  "private": true,
  "description": "EDMG NVIDIA Workshop desktop app",
  "author": "Dwct",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.33.0 <11"
  },
  "main": "main.mjs",
  "scripts": {
    "preinstall": "node scripts/enforce-package-manager.mjs",
    "dev": "concurrently -k -s command-1 \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "pnpm run test:ui",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "lint": "eslint src main.mjs preload.cjs main-process scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:tooling": "node scripts/check-tooling.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "prepare:release-bundle": "node scripts/prepare-release-bundle.mjs",
    "release:stage-desktop": "node scripts/release-stage-desktop.mjs",
    "validate:electron-bridge": "node --check main.mjs && node --check preload.cjs && node --check main-process/backend-runtime.mjs && node --check main-process/director-runtime.mjs && node --check main-process/window-runtime.mjs",
    "validate:desktop-integration": "node scripts/desktop-integration-harness.mjs --require-live-probe",
    "validate:desktop-integration:best-effort": "node scripts/desktop-integration-harness.mjs",
    "validate:desktop-integration:strict": "pnpm run validate:desktop-integration",
    "validate:packaged-desktop-smoke": "node scripts/packaged-desktop-smoke.mjs",
    "validate:packaged-customer-flow": "node scripts/packaged-customer-flow.mjs",
    "validate:packaged-upgrade-proof": "node scripts/packaged-upgrade-proof.mjs",
    "validate:packaged-nvidia-setup": "node scripts/packaged-nvidia-setup-proof.mjs",
    "validate:desktop": "pnpm run check:tooling && pnpm run typecheck && pnpm run test:ui && pnpm run build && pnpm run prepare:release-bundle && pnpm run release:stage-desktop && pnpm run check:release-metadata && pnpm run validate:electron-bridge && pnpm run validate:desktop-integration && pnpm run validate:packaged-desktop-smoke",
    "validate:release": "pnpm run validate:desktop && pnpm run dist:win && pnpm run validate:packaged-customer-flow && pnpm run validate:packaged-upgrade-proof && pnpm run validate:packaged-nvidia-setup",
    "validate:release:linux": "pnpm run validate:desktop && pnpm run dist:linux",
    "build:electron": "pnpm run build && pnpm run prepare:release-bundle && pnpm run release:stage-desktop && pnpm run check:release-metadata && node scripts/run-electron-builder.mjs --dir -c.directories.app=release/staged-app",
    "dist:win": "pnpm run build && pnpm run prepare:release-bundle && pnpm run release:stage-desktop && pnpm run check:release-metadata && node scripts/run-electron-builder.mjs -w --x64 -c.directories.app=release/staged-app",
    "dist:win:inno": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/windows/build_inno_external.ps1",
    "dist:linux": "pnpm run build && pnpm run prepare:release-bundle && pnpm run release:stage-desktop && pnpm run check:release-metadata && node scripts/run-electron-builder.mjs -l AppImage --x64 -c.directories.app=release/staged-app",
    "backend:use": "node scripts/use-backend.mjs"
  },
  "dependencies": {
    "@huggingface/hub": "^2.11.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "electron": "41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-babel": "^1.6.0",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.dwct.edmgnvidiaworkshop",
    "productName": "EDMG NVIDIA Workshop",
    "icon": "electron-resources/app-icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "electron-resources"
    },
    "files": [
      "dist-web/**",
      "main.mjs",
      "main-process/**",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron-resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron-resources/app-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "EDMG NVIDIA Workshop Setup ${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
