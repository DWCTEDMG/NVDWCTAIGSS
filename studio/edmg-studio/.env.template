# EDMG NVIDIA Workshop (Desktop) runtime env defaults

# Backend
EDMG_STUDIO_DATA_DIR=./data
EDMG_STUDIO_BACKEND_HOST=127.0.0.1
EDMG_STUDIO_BACKEND_PORT=7863
VITE_EDMG_BACKEND_URL=http://127.0.0.1:7863
EDMG_DIRECTOR_HOST=127.0.0.1
EDMG_DIRECTOR_PORT=3001
# Optional if you expose the managed Director app over HTTPS for ChatGPT:
# EDMG_DIRECTOR_BASE_URL=https://your-public-director-host

# AI (default: NVIDIA NIM / OpenAI-compatible)
EDMG_AI_MODE=local
EDMG_AI_PROVIDER=openai_compat
EDMG_NVIDIA_MODE=1
EDMG_NVIDIA_PROFILE=omniverse
EDMG_NVIDIA_NIM_URL=http://127.0.0.1:8001
EDMG_AI_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8001/v1
EDMG_AI_OPENAI_COMPAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
EDMG_NVIDIA_RIVA_URL=127.0.0.1:50051
EDMG_NVIDIA_RIVA_ASR=1
EDMG_NVIDIA_RIVA_LANGUAGE_CODE=en-US
EDMG_NVIDIA_RIVA_ASR_FALLBACK=0

# ComfyUI
EDMG_COMFYUI_URL=http://127.0.0.1:8188
# Multi-node example:
# EDMG_COMFYUI_URLS=http://127.0.0.1:8188,http://192.168.1.50:8188

# FFmpeg (Option B): install FFmpeg and ensure it's on PATH, or set EDMG_FFMPEG_PATH to the ffmpeg executable.
EDMG_FFMPEG_PATH=ffmpeg

# Optional tokens (recommended to set via Studio Settings → Tokens)
# HF_TOKEN=
# CIVITAI_API_KEY=

# Optional S3-backed model hosting / cache
# Requires AWS credentials through the normal AWS provider chain or env vars.
# EDMG_AWS_MODEL_CACHE=1
# EDMG_AWS_MODEL_CACHE_BUCKET=your-model-bucket
# EDMG_AWS_MODEL_CACHE_PREFIX=models
# EDMG_MODEL_STORAGE_MODE=local_cache
# Use cloud_only to store supported single-file models in S3 without keeping a local copy:
# EDMG_MODEL_STORAGE_MODE=cloud_only
# Optional S3-compatible endpoint:
# EDMG_S3_ENDPOINT_URL=https://s3-compatible.example.com
