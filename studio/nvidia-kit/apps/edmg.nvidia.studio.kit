[package]
title = "EDMG NVIDIA Studio"
description = "Omniverse Kit proof-of-concept shell for the NVIDIA-first EDMG Studio lane."
version = "0.1.0"

[dependencies]
"omni.kit.uiapp" = {}
"omni.hydra.rtx" = {}
"omni.kit.renderer.capture" = {}
"omni.kit.window.stage" = {}
"omni.kit.viewport.utility" = {}
"omni.kit.viewport.window" = {}
"omni.usd" = {}
"edmg.timeline" = {}
"edmg.ai_director" = {}
"edmg.usd_schema" = {}
"edmg.render_queue" = {}

[settings.app]
name = "EDMG NVIDIA Studio"
version = "0.1.0"

[settings.app.exts]
folders = [
  "${app}/../extensions"
]

[settings]
renderer.enabled = "rtx,pxr"
renderer.active = "rtx"
rtx.rendermode = "RaytracedLighting"

[settings.edmg.nvidia]
backend_url = "http://127.0.0.1:8000"
ffmpeg_path = "ffmpeg"
projects_root = "${app}/../../edmg-studio/python_backend/data/projects"
render_worker_autorun = false
render_worker_poll_s = 5.0
sample_stage = "${app}/../sample_projects/audio_reactive_stage/stage.usda"
sample_scene_plan = "${app}/../sample_projects/audio_reactive_stage/scene_plan.json"
